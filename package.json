{
  "name": "siklo-web",
  "private": true,
  "version": "1.0.0",
  "description": "SikLo: a private, offline menstrual cycle tracker and health companion.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.checks.json",
    "test": "node build.mjs --check",
    "knowledge": "cd backend && python3 -m siklo_knowledge.build",
    "knowledge:test": "cd backend && python3 -m pytest -q"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
